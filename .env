# Default: call each microservice directly (no Caddy).
# Switch with: npm run dev:direct  → --mode direct (uses .env.direct → 8081/8082/8083)
#              npm run dev         → --mode development (uses .env.development → :8080)

VITE_AUTH_API_URL=http://localhost:8081
VITE_CONTENT_API_URL=http://localhost:8082
VITE_COURSES_API_URL=http://localhost:8083
